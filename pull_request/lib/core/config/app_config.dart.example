/// App-level configuration constants.
///
/// Setup:
///   1. Copy this file -> `app_config.dart` (same directory).
///   2. Fill in each value below.
///   3. `app_config.dart` is gitignored — never commit it.
abstract final class AppConfig {
  static const spotifyClientId = 'YOUR_SPOTIFY_CLIENT_ID';
  static const backendUrl = 'http://localhost:3000';
  static const googleClientId = 'YOUR_GOOGLE_CLIENT_ID';
  static const redirectUri = 'pullrequest://callback';
  static const spotifyScopes =
      'playlist-read-private playlist-read-collaborative '
      'playlist-modify-public playlist-modify-private';
  static const googleScopes = 'https://www.googleapis.com/auth/youtube';
}
